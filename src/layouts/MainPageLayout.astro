---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Search from '@components/misc/Search.astro';
import KnowledgeTree from '@components/knowledge/KnowledgeTree.astro';
import type { ArticleTreeContext, DirectoryTreeContext } from '@utils/content-tree';
import { getContentTree } from '@utils/content-tree';


interface Props {
  title: string;
  lang: string;
  description?: string;
  pagefindIgnore?: boolean;
  treeContext?: ArticleTreeContext | DirectoryTreeContext;
}
const { title, lang, description, pagefindIgnore = false, treeContext } = Astro.props;
const tree = await getContentTree(lang);

---

<Layout title={title} lang={lang} description={description}>
  <div class="site-shell flex flex-col min-h-screen" data-pagefind-ignore={pagefindIgnore ? "" : undefined}>
    <Header />
    <main class="site-main flex-grow">
      <div class="site-sidebar">
        <KnowledgeTree roots={tree.roots} treeContext={treeContext} lang={lang} />
      </div>
      <div class="site-page-content page-shell">
        <slot />
      </div>
    </main>
    <Footer />
    <Search />
  </div>
</Layout>

<style>
  .site-main { display: grid; grid-template-columns: 15rem minmax(0, 1fr); align-items: start; }
  .site-sidebar { position: sticky; top: 6rem; align-self: start; min-width: 0; height: calc(100vh - 6rem); overflow: hidden; border-right: 1px solid var(--button-border-color); }
  .site-sidebar :global(.knowledge-tree) { position: static; width: 100%; height: 100%; max-height: none; padding: 1.25rem 1rem 2rem 1.25rem; overflow: auto; }
  .site-page-content { width: min(var(--content-width), calc(100% - 3rem)); min-width: 0; margin-inline: auto; }
  @media (max-width: 1199px) {
    .site-main { grid-template-columns: 13.75rem minmax(0, 1fr); }
  }
  @media (max-width: 1023px) {
    .site-main { display: block; }
    .site-sidebar { display: none; }
    .site-page-content { width: min(var(--content-width), calc(100vw - 1.5rem)); }
  }
</style>
