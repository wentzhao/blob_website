---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import { getBlogEntrySort } from "@utils/content-utils";
import { getContentTree } from "@utils/content-tree";
import type { DirectoryNode } from "@utils/content-tree";
import { siteConfig } from "@/config";
import { i18n } from "astro:config/client";
import i18nit from "@i18n/translation";
import { getRelativeLocaleUrl } from "@utils/url-utils";
import { formatBlogDate } from "@utils/time";
import { getBlogLastUpdated } from "@utils/content-utils";

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);
const entries = await getBlogEntrySort(currentLang);
const tree = await getContentTree(currentLang);

function collectArticles(directory: DirectoryNode): DirectoryNode["articles"][number][] {
  return [
    ...directory.articles,
    ...directory.directories.flatMap((child) => collectArticles(child)),
  ];
}

const categorySummaries = tree.roots.map((root) => {
  const articles = collectArticles(root);
  const lastUpdated = articles.length > 0
    ? new Date(Math.max(...articles.map((article) => getBlogLastUpdated(article.data).valueOf())))
    : undefined;

  return { root, articleCount: articles.length, lastUpdated };
});

const lastUpdated = entries.length > 0
  ? new Date(Math.max(...entries.map((entry) => getBlogLastUpdated(entry.data).valueOf())))
  : undefined;

export function getStaticPaths() {
  return [{ params: { locale: undefined } }];
}

const pageTitle = `${siteConfig.title} - ${siteConfig.subTitle}`;
---

<MainPageLayout title={pageTitle} lang={currentLang} description="一个以知识库方式组织的个人博客。" pagefindIgnore>
  <div class="home-page">
    <section class="home-intro">
      <h1>Note</h1>
    </section>

    <section class="site-info-card" aria-label={t("home.infoAriaLabel")}>
      <div class="site-info-card__content">
        <p class="site-info-card__label">{t("home.infoLabel")}</p>
        <h2>{t("home.infoTitle")}</h2>
        <p>{t("home.infoDescription")}</p>
      </div>
      <div class="site-info-card__visual" aria-hidden="true">
        <div class="visual-notebook">
          <div class="visual-notebook__cover">
            <span class="visual-notebook__bookmark"></span>
            <span class="visual-notebook__title">NOTE</span>
            <span class="visual-notebook__rule"></span>
            <span class="visual-notebook__rule visual-notebook__rule--short"></span>
          </div>
          <div class="visual-notebook__pages">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>
      </div>
      <div class="site-info-card__stats">
        <div>
          <span>{t("home.topCategoriesCount")}</span>
          <strong>{tree.roots.length}</strong>
        </div>
        <div>
          <span>{t("home.publicArticles")}</span>
          <strong>{entries.length}</strong>
        </div>
        <div>
          <span>{t("home.lastUpdated")}</span>
          <strong>{lastUpdated ? formatBlogDate(lastUpdated, currentLang) : t("directory.noUpdates")}</strong>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="latest-updates-heading">
      <div class="section-heading">
        <h2 id="latest-updates-heading">最新发布</h2>
      </div>
      <div class="latest-list">
        {entries.slice(0, 5).map((entry) => (
          <a class="latest-item" href={getRelativeLocaleUrl(currentLang, `/blog/${entry.id}/`)}>
            <span>{entry.data.title}</span>
            <time datetime={entry.data.pubDate.toISOString()}>{formatBlogDate(entry.data.pubDate, currentLang)}</time>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section" aria-labelledby="top-categories-heading">
      <div class="section-heading">
        <h2 id="top-categories-heading">顶级分类</h2>
      </div>
      <div class="category-table-wrap">
        <table class="category-table">
          <thead>
            <tr>
              <th scope="col">分类</th>
              <th scope="col">子目录</th>
              <th scope="col">文章总数</th>
              <th scope="col">最后更新</th>
            </tr>
          </thead>
          <tbody>
            {categorySummaries.map(({ root, articleCount, lastUpdated }) => (
              <tr>
                <th scope="row">
                  <a href={getRelativeLocaleUrl(currentLang, `/knowledge/${root.id}/`)}>{root.label}</a>
                  <span>{root.description}</span>
                </th>
                <td>{root.directories.length}</td>
                <td>{articleCount}</td>
                <td>{lastUpdated ? formatBlogDate(lastUpdated, currentLang) : "暂无更新"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</MainPageLayout>

<style>
  .home-page { padding-top: 7rem; padding-bottom: 6rem; }
  .home-intro { max-width: 820px; padding: 1rem 0 6rem; }
  .eyebrow { margin: 0; color: var(--accent-color); font: 700 .72rem/1.2 "JetBrains Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  .home-intro h1 { margin: 0; font-size: clamp(2.6rem, 7vw, 4.7rem); line-height: 1.08; letter-spacing: -.06em; }
  .site-info-card { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(14rem, .85fr); gap: 2.5rem; align-items: center; margin-bottom: 5rem; padding: 2rem; border: 1px solid var(--button-border-color); border-radius: 1rem; background: linear-gradient(135deg, var(--surface-color), var(--button-hover-color)); }
  .site-info-card__content { min-width: 0; }
  .site-info-card__label { margin: 0 0 .7rem; color: var(--accent-color); font-size: .78rem; font-weight: 700; letter-spacing: .08em; }
  .site-info-card h2 { margin: 0; font-size: clamp(1.4rem, 3vw, 2rem); letter-spacing: -.04em; }
  .site-info-card__content > p:last-child { max-width: 32rem; margin: .85rem 0 0; color: var(--text-color-70); line-height: 1.8; }
  .site-info-card__visual { position: relative; display: grid; min-height: 11rem; place-items: center; overflow: hidden; border: 1px solid var(--button-border-color); border-radius: .75rem; background: var(--bg-color); }
  .site-info-card__visual::before { position: absolute; width: 12rem; height: 7rem; content: ""; border-radius: 50%; background: color-mix(in srgb, var(--link-color) 10%, transparent); transform: rotate(-12deg); }
  .visual-notebook { position: relative; z-index: 1; width: 7.5rem; height: 8.5rem; transform: rotate(-7deg); }
  .visual-notebook__pages { position: absolute; right: -.35rem; bottom: -.3rem; display: flex; flex-direction: column; gap: .55rem; width: 6.35rem; height: 7.65rem; padding: 2.1rem .75rem .75rem; border: 1px solid var(--button-border-color); border-radius: .25rem .6rem .6rem .25rem; background: var(--surface-color); box-shadow: .3rem .35rem 0 color-mix(in srgb, var(--text-color) 12%, transparent); }
  .visual-notebook__pages span { display: block; height: .16rem; border-radius: 1rem; background: color-mix(in srgb, var(--link-color) 38%, var(--button-border-color)); }
  .visual-notebook__pages span:nth-child(2) { width: 82%; }
  .visual-notebook__pages span:nth-child(3) { width: 58%; }
  .visual-notebook__cover { position: absolute; top: 0; left: 0; z-index: 2; display: flex; flex-direction: column; gap: .55rem; width: 6.4rem; height: 7.7rem; padding: 1.35rem .9rem .8rem 1.15rem; border: 1px solid var(--link-color); border-radius: .35rem .6rem .6rem .35rem; background: linear-gradient(145deg, var(--link-color), var(--accent-color)); box-shadow: .4rem .45rem 0 color-mix(in srgb, var(--link-color) 22%, transparent); }
  .visual-notebook__bookmark { position: absolute; top: 0; right: .75rem; width: .65rem; height: 2.3rem; background: var(--accent-color); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%); }
  .visual-notebook__title { color: var(--surface-color); font: 700 .7rem/1 "JetBrains Mono", monospace; letter-spacing: .08em; }
  .visual-notebook__rule { display: block; width: 100%; height: .22rem; margin-top: 1.7rem; border-radius: 1rem; background: color-mix(in srgb, var(--surface-color) 80%, transparent); }
  .visual-notebook__rule--short { width: 62%; margin-top: -.15rem; }
  .site-info-card__stats { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; padding-top: 1.35rem; border-top: 1px solid var(--button-border-color); }
  .site-info-card__stats div { display: flex; flex-direction: column; gap: .4rem; min-width: 0; }
  .site-info-card__stats span { color: var(--text-color-70); font-size: .78rem; }
  .site-info-card__stats strong { overflow-wrap: anywhere; font-size: clamp(1.15rem, 2.5vw, 1.65rem); line-height: 1.2; }
  .home-section { border-top: 1px solid var(--button-border-color); padding: 3.5rem 0 0; }
  .home-section + .home-section { margin-top: 5rem; }
  .section-heading { display: flex; align-items: center; gap: .8rem; margin-bottom: 1rem; }
  .section-heading::before { content: ""; width: .28rem; height: 2.1rem; background: var(--link-color); }
  .section-heading h2 { margin: 0; font-size: clamp(1.7rem, 3vw, 2.15rem); letter-spacing: -.04em; }
  .latest-list { display: flex; flex-direction: column; }
  .latest-item { display: flex; justify-content: space-between; gap: 1.5rem; padding: .9rem 0; border-bottom: 1px solid var(--button-border-color); transition: background .2s ease, color .2s ease; }
  .latest-item:hover { background: var(--button-hover-color); color: var(--link-color); }
  .latest-item time { flex: none; color: var(--text-color-70); font-size: .82rem; }
  .category-table-wrap { overflow-x: auto; }
  .category-table { width: 100%; border-collapse: collapse; text-align: left; }
  .category-table th, .category-table td { border-bottom: 1px solid var(--button-border-color); padding: 1rem .5rem; }
  .category-table thead th { color: var(--text-color-70); font-size: .8rem; font-weight: 500; }
  .category-table tbody th { min-width: 15rem; font-weight: 700; }
  .category-table tbody th a { display: block; font-size: 1.05rem; }
  .category-table tbody th a:hover { color: var(--link-color); }
  .category-table tbody th span { display: block; margin-top: .3rem; color: var(--text-color-70); font-size: .82rem; font-weight: 400; line-height: 1.5; }
  .category-table td { color: var(--text-color-70); font-size: .88rem; white-space: nowrap; }
  @media (max-width: 640px) {
    .home-page { padding-top: 4rem; padding-bottom: 4rem; }
    .home-intro { padding-bottom: 3.5rem; }
    .site-info-card { grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 3.5rem; padding: 1.25rem; }
    .site-info-card__visual { min-height: 9rem; }
    .site-info-card__stats { gap: .75rem; }
    .site-info-card__stats strong { font-size: 1.05rem; }
    .home-section { padding-top: 2.75rem; }
    .home-section + .home-section { margin-top: 3.5rem; }
    .latest-item { align-items: flex-start; flex-direction: column; gap: .35rem; }
    .latest-item time { font-size: .78rem; }
    .category-table { min-width: 34rem; }
  }
</style>
