---
import { i18n } from "astro:config/client";
import { siteConfig } from "@/config";
import i18nit from "@i18n/translation";
import Footer from "@components/Footer.astro";
import ThemeIcon from "@components/control/ThemeIcon.astro";
import Layout from "@layouts/Layout.astro";
import { getNoteHomeUrl } from "@utils/url-utils";

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);
const portal = {
  ariaLabel: t("portal.ariaLabel"),
  eyebrow: t("portal.eyebrow"),
  title: t("portal.title"),
  description: t("portal.description"),
  note: {
    label: t("portal.note.label"),
    description: t("portal.note.description"),
    action: t("portal.note.action"),
  },
  project: {
    label: t("portal.project.label"),
    description: t("portal.project.description"),
  },
  lab: {
    label: t("portal.lab.label"),
    description: t("portal.lab.description"),
  },
  comingSoon: t("portal.comingSoon"),
};
const pageTitle = `${siteConfig.title} - ${siteConfig.subTitle}`;

export function getStaticPaths() {
  return [{ params: { locale: undefined } }];
}
---

<Layout title={pageTitle} lang={currentLang} description={portal.description}>
  <div class="portal-shell" data-pagefind-ignore>
    <header class="portal-header">
      <span class="portal-brand" aria-label="wentZh">/ wentZh</span>
      <ThemeIcon class="portal-theme-button" />
    </header>

    <main class="portal-page" aria-label={portal.ariaLabel}>
      <section class="portal-intro">
        <p>{portal.eyebrow}</p>
        <h1>{portal.title}</h1>
        <div>{portal.description}</div>
      </section>

      <section class="portal-entries" aria-label={portal.ariaLabel}>
        <a class="portal-card portal-card--available" href={getNoteHomeUrl(currentLang)}>
          <span class="portal-card__index" aria-hidden="true">01</span>
          <div>
            <h2>{portal.note.label}</h2>
            <p>{portal.note.description}</p>
          </div>
          <span class="portal-card__action">{portal.note.action} <span aria-hidden="true">→</span></span>
        </a>
        <article class="portal-card" aria-label={`${portal.project.label}，${portal.comingSoon}`}>
          <span class="portal-card__index" aria-hidden="true">02</span>
          <div>
            <h2>{portal.project.label}</h2>
            <p>{portal.project.description}</p>
          </div>
          <span class="portal-card__status">{portal.comingSoon}</span>
        </article>
        <article class="portal-card" aria-label={`${portal.lab.label}，${portal.comingSoon}`}>
          <span class="portal-card__index" aria-hidden="true">03</span>
          <div>
            <h2>{portal.lab.label}</h2>
            <p>{portal.lab.description}</p>
          </div>
          <span class="portal-card__status">{portal.comingSoon}</span>
        </article>
      </section>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .portal-shell { display: flex; flex-direction: column; min-height: 100vh; }
  .portal-header { display: flex; align-items: center; justify-content: space-between; width: min(68rem, calc(100% - 3rem)); margin: 0 auto; padding: 1.25rem 0; }
  .portal-brand { font: 800 1.1rem/1 "JetBrains Mono", monospace; letter-spacing: -.06em; }
  .portal-brand::first-letter { color: var(--accent-color); }
  .portal-theme-button { width: 2.5rem; height: 2.5rem; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--button-border-color); border-radius: 999px; background: var(--bg-color); color: var(--text-color-70); cursor: pointer; }
  .portal-theme-button:hover { color: var(--link-color); background: var(--button-hover-color); }
  .portal-page { width: min(68rem, calc(100% - 3rem)); flex: 1; margin: 0 auto; padding: clamp(4rem, 12vh, 8rem) 0 5rem; }
  .portal-intro { max-width: none; }
  .portal-intro p { margin: 0 0 1rem; color: var(--accent-color); font: 700 .78rem/1.2 "JetBrains Mono", monospace; letter-spacing: .1em; }
  .portal-intro h1 { margin: 0; font-size: clamp(3rem, 8vw, 6.4rem); line-height: .98; letter-spacing: -.07em; white-space: nowrap; }
  .portal-intro div { max-width: 35rem; margin-top: 1.5rem; color: var(--text-color-70); font-size: clamp(1rem, 1.5vw, 1.16rem); line-height: 1.8; }
  .portal-entries { display: grid; gap: .85rem; margin-top: clamp(4rem, 10vh, 7rem); }
  .portal-card { display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto; align-items: center; gap: 1.5rem; min-width: 0; padding: 1.5rem; border: 1px solid var(--button-border-color); border-radius: .75rem; background: color-mix(in srgb, var(--surface-color) 78%, transparent); }
  .portal-card--available { transition: transform .2s ease, border-color .2s ease, background .2s ease; }
  .portal-card--available:hover, .portal-card--available:focus-visible { border-color: var(--link-color); background: var(--button-hover-color); transform: translateY(-2px); }
  .portal-card__index { align-self: start; color: var(--text-color-70); font: 700 .78rem/1.2 "JetBrains Mono", monospace; }
  .portal-card h2 { margin: 0; font-size: clamp(1.35rem, 2.5vw, 1.8rem); letter-spacing: -.04em; }
  .portal-card p { margin: .45rem 0 0; color: var(--text-color-70); line-height: 1.65; }
  .portal-card__action, .portal-card__status { align-self: end; white-space: nowrap; font-size: .86rem; }
  .portal-card__action { color: var(--link-color); font-weight: 700; }
  .portal-card__status { color: var(--text-color-70); }
  .portal-shell :global(.site-footer) { width: min(68rem, calc(100% - 3rem)); }
  @media (max-width: 640px) { .portal-header, .portal-page { width: min(100% - 1.5rem, 68rem); }.portal-page { padding-top: 3.5rem; }.portal-intro h1 { white-space: normal; }.portal-card { grid-template-columns: 2rem minmax(0, 1fr); gap: 1rem; padding: 1.25rem; }.portal-card__action, .portal-card__status { grid-column: 2; justify-self: start; align-self: auto; }.portal-shell :global(.site-footer) { width: min(100% - 1.5rem, 68rem); } }
</style>
