---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import SectionOverview from "@components/knowledge/SectionOverview.astro";
import { topSections } from "@/content/navigation";
import { getBlogEntrySort } from "@utils/content-utils";
import { siteConfig } from "@/config";
import { i18n } from "astro:config/client";
import i18nit from "@i18n/translation";
import { getRelativeLocaleUrl } from "@utils/url-utils";

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);
const entries = await getBlogEntrySort(currentLang);

export function getStaticPaths() {
  return i18n!.locales.map((locale) => ({
    params: { locale: locale === i18n!.defaultLocale ? undefined : locale },
  }));
}

const pageTitle = `${siteConfig.title} - ${siteConfig.subTitle}`;
---

<MainPageLayout title={pageTitle} lang={currentLang} description="一个以知识库方式组织的个人博客。">
  <div class="page-shell home-page">
    <section class="home-intro">
      <p class="eyebrow">A quiet place to think</p>
      <h1>{t("cover.title.home")}</h1>
      <p class="home-intro__description">把学习、实践和思考整理成可以再次进入的路径。</p>
      <div class="home-intro__meta">
        <span>{entries.length} 篇公开文章</span>
        <a href={getRelativeLocaleUrl(currentLang, "/archives/")}>浏览全部归档 →</a>
      </div>
    </section>

    <div class="knowledge-index">
      {topSections.map((section) => <SectionOverview section={section} entries={entries} lang={currentLang} />)}
    </div>
  </div>
</MainPageLayout>

<style>
  .home-page { padding-top: 7rem; }
  .home-intro { max-width: 820px; padding: 1rem 0 6rem; }
  .eyebrow { margin: 0; color: var(--accent-color); font: 700 .72rem/1.2 "JetBrains Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  .home-intro h1 { margin: 1rem 0 .9rem; font-size: clamp(2.6rem, 7vw, 4.7rem); line-height: 1.08; letter-spacing: -.06em; }
  .home-intro__description { margin: 0; color: var(--text-color-70); font-size: 1.1rem; line-height: 1.8; }
  .home-intro__meta { display: flex; gap: 1.2rem; align-items: center; margin-top: 1.6rem; color: var(--text-color-70); font-size: .88rem; }
  .home-intro__meta a { color: var(--link-color); }
  .knowledge-index { border-bottom: 1px solid var(--button-border-color); }
  @media (max-width: 640px) { .home-page { padding-top: 4rem; } .home-intro { padding-bottom: 3.5rem; } .home-intro__meta { align-items: flex-start; flex-direction: column; gap: .55rem; } }
</style>
