---
import "@styles/global.css";
import { siteConfig, licenseConfig } from "@/config";
import MainPageLayout from "@layouts/MainPageLayout.astro";
import Markdown from "@components/misc/Markdown.astro";
import ImageModule from "@components/misc/ImageModule.astro";
import FabMenu from "@components/control/FabMenu.astro";
import LicenseCard from "@components/misc/LicenseCard.astro";
import Comments from "@components/comment/Comments.svelte";
import Twikoo from "@components/comment/thirdparty/twikoo.astro";
import BlogNavi from "@components/control/BlogNavi.astro";
import OnThisPage from "@components/knowledge/OnThisPage.astro";
import { render } from "astro:content";
import { i18n } from "astro:config/client";
import i18nit from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { blogCoverUrl, getNoteHomeUrl, getRelativeLocaleUrl } from "@utils/url-utils";
import { formatBlogDate } from "@utils/time";
import { getBlogEntrySort } from "@utils/content-utils";
import { getArticleTreeContext, getContentTree } from "@utils/content-tree";

const currentLang = i18n!.defaultLocale;
const t = i18nit(currentLang);

export async function getStaticPaths() {
  const paths = [];
  const localeCode = i18n!.defaultLocale;
  await getContentTree(localeCode);
  const entries = await getBlogEntrySort(localeCode);
  for (let index = 0; index < entries.length; index += 1) {
    paths.push({
      params: { locale: undefined, id: entries[index].id },
      props: {
        entry: entries[index],
        prev: entries[index + 1] || null,
        next: entries[index - 1] || null,
        treeContext: await getArticleTreeContext(localeCode, entries[index].id),
      },
    });
  }
  return paths;
}

const { entry, prev, next, treeContext } = Astro.props;
if (!treeContext) throw new Error(`Missing content tree context for article ${entry.id}`);
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const pageTitle = `${entry.data.title} - ${siteConfig.title}`;
const image = blogCoverUrl(entry.data.image, entry.id);
---

<MainPageLayout title={pageTitle} lang={currentLang} description={entry.data.description} treeContext={treeContext}>
  <div class="article-layout">
    <article class="article-main">
      <header class="article-header">
        <nav class="article-breadcrumbs" aria-label="文章路径">
          <a href={getNoteHomeUrl(currentLang)}>{t("directory.home")}</a>
          {treeContext.path.map((node) => (
            <>
              <span aria-hidden="true">/</span>
              {node.kind === "directory" ? (
                <a href={getRelativeLocaleUrl(currentLang, `/knowledge/${node.id}/`)}>{node.label}</a>
              ) : (
                <span aria-current="page">{node.data.title}</span>
              )}
            </>
          ))}
        </nav>
        <p class="eyebrow">{entry.data.category || t("pagecard.uncategorized")}</p>
        <h1>{entry.data.title}</h1>
        {entry.data.description && <p class="article-description">{entry.data.description}</p>}
        <div class="article-meta">
          <span><Icon name="fa6-solid:calendar-days" /> {t("article.publishedOn")} {formatBlogDate(entry.data.pubDate, currentLang)}</span>
          {entry.data.updatedDate && <span><Icon name="fa6-solid:clock" /> {t("article.updatedOn")} {formatBlogDate(entry.data.updatedDate, currentLang)}</span>}
          <span>{remarkPluginFrontmatter.words || 0} {t("pagecard.words")}</span>
          <span>{remarkPluginFrontmatter.minutes || 0} {t("pagecard.minutes")}</span>
          <a href={getRelativeLocaleUrl(currentLang, `/archives/?category=${encodeURIComponent(entry.data.category || "")}`)}>查看分类 →</a>
        </div>
      </header>

      {image && <div class="article-cover"><ImageModule src={image} alt={entry.data.title} class="w-full h-full object-cover" /></div>}

      {entry.isFallback && <div class="fallback-note">{t("langNote.note")}{t("langNote.description")}</div>}

      <Markdown class="markdown-content">
        <Content />
      </Markdown>

      {licenseConfig.enable && <LicenseCard title={entry.data.title} pubDate={entry.data.pubDate} />}
      {siteConfig.blogNavi.enable && <BlogNavi prev={prev} next={next} />}
      {siteConfig.comments.enable && siteConfig.comments.platform === "default" && <Comments postSlug={entry.data.slugId} language={currentLang} postTitle={entry.data.title} client:visible />}
      {siteConfig.comments.enable && siteConfig.comments.platform === "twikoo" && <Twikoo postSlug={entry.data.slugId} language={currentLang} envId={siteConfig.comments.backendUrl} />}
    </article>

    <OnThisPage headings={headings} />
  </div>
  <FabMenu headings={headings} showComment={siteConfig.comments.enable} showBackBottom={!siteConfig.comments.enable} />
</MainPageLayout>

<style>
  .article-layout { display: grid; grid-template-columns: minmax(0, var(--reading-width)) minmax(0, 1fr); gap: 2rem; padding-top: 7rem; }
  .article-main { min-width: 0; }
  .article-main :global(a) { overflow-wrap: anywhere; }
  .article-header { min-width: 0; padding-bottom: 2.5rem; border-bottom: 1px solid var(--button-border-color); }
  .article-breadcrumbs { display: flex; flex-wrap: wrap; gap: .45rem; margin-bottom: 2rem; color: var(--text-color-70); font-size: .82rem; line-height: 1.5; }
  .article-breadcrumbs a, .article-breadcrumbs span { min-width: 0; overflow-wrap: anywhere; }
  .article-breadcrumbs a:hover { color: var(--link-color); }
  .eyebrow { margin: 0 0 .75rem; color: var(--accent-color); font: 700 .72rem/1.2 "JetBrains Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  .article-header h1 { margin: 0; font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.12; letter-spacing: -.055em; }
  .article-description { margin: 1rem 0 0; color: var(--text-color-70); line-height: 1.7; }
  .article-meta { display: flex; flex-wrap: wrap; gap: .75rem 1rem; margin-top: 1.2rem; color: var(--text-color-70); font-size: .8rem; }
  .article-meta span { display: inline-flex; align-items: center; gap: .35rem; }
  .article-meta a { color: var(--link-color); }
  .article-cover { max-height: 360px; margin: 2rem 0; overflow: hidden; border-radius: .7rem; }
  .fallback-note { margin: 1.5rem 0; padding: .8rem 1rem; border-left: 3px solid var(--accent-color); background: var(--surface-color); color: var(--text-color-70); font-size: .9rem; }
  @media (max-width: 1199px) {
    .article-layout { grid-template-columns: minmax(0, 1fr); width: min(var(--reading-width), 100%); margin-inline: auto; padding-top: 5rem; }
    .article-layout > :global(.on-this-page) { display: none; }
  }
  @media (max-width: 1023px) { .article-layout { display: block; width: min(var(--reading-width), calc(100vw - 2rem)); padding-top: 3rem; } }
  @media (max-width: 640px) { .article-layout { width: calc(100vw - 1.5rem); padding-top: 2.5rem; } .article-header h1 { font-size: 2rem; } .article-meta { gap: .5rem .8rem; } }
</style>
